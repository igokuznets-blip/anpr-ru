# Скопируйте в .env и заполните. Файл .env не коммитится.
# Адреса камер подставляются в cameras.yml как ${CAM1_URL}, ${CAM2_URL}, ...
CAM1_URL=rtsp://user:password@192.168.1.10:554/stream1
CAM2_URL=rtsp://user:password@192.168.1.11:554/stream1
# IP хоста, по которому браузеры подключаются к интерфейсу (нужно для WebRTC)
WEBRTC_HOST=192.168.1.100
HTTP_PORT=8080
RTSP_PORT=8554
# easyocr | crnn (crnn требует models/crnn.pt, см. tools/train_crnn.py)
ANPR_OCR=easyocr
# cpu | 0 (индекс GPU, используйте docker-compose.gpu.yml)
ANPR_DEVICE=cpu
ANPR_FPS=15
ANPR_MIN_VOTES=3
# Префикс образов, например ghcr.io/<user>/anpr-ru
IMAGE_PREFIX=anpr-ru
TAG=latest
